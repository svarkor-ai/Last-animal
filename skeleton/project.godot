; Engine configuration file (Godot 4.7.2-stable pinned, see ../engine/PIN.txt).
; Last Animal - full game (MC 1344); started as the M00 preflight skeleton (MC 839.1, gunilla, 2026-08-30).
; REPAIRED + C# wired in MC 839.2 (gunilla, 2026-08-31): the 839.1 copy of this file
; was written truncated and its last line ended with the literal text "[truncated]",
; so the file did not parse. Full content restored below; do not re-truncate.
; W1 bridge (MC 1123.2, artemis, 2026-09-07): register the real autoloads
; EventBus/GameBootstrap/SfxRouter (RG1) + add the player input map WASD+arrows+attack
; (RG3). Closes BRIDGE-MVP.md §2 STEP A + STEP D.

config_version=5

[application]

config/name="Last Animal"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[dotnet]

project/assembly_name="LastAnimalPreflight"

[rendering]

renderer/rendering_method="forward_plus"

[autoload]

MusicManager="*res://autoload/MusicManager.cs"
EventBus="*res://autoload/EventBus.cs"
GameBootstrap="*res://autoload/GameBootstrap.cs"
SfxRouter="*res://autoload/SfxRouter.cs"
GameLoop="*res://autoload/GameLoop.cs"

