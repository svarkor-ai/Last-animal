<Project Sdk="Microsoft.NET.Sdk">
  <!-- Last Animal — M08 combat-3d pure-logic test project (MC 890.13, artemis, 2026-09-06).
       This is a STANDALONE test project: it references the M08 source files
       directly (via Compile Include) so `dotnet test` runs the C10+C11
       combat suites headless without pulling in the Godot SDK. The Godot
       project (LastAnimalPreflight.csproj) compiles the same source files
       for the engine; this project is the test-only entry point. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Assembly name must not collide with the Godot project's assembly. -->
    <AssemblyName>LastAnimalCombatTests</AssemblyName>
    <RootNamespace>LastAnimal.Tests</RootNamespace>
    <!-- Compile ONLY the explicitly listed files below. Do not glob the
         tests/ dir for .cs — other milestone tests (AudioTest.cs,
         BootTest.cs, CompanionSystemTests.cs, EmpathyBookTests.cs, etc.)
         require GodotSharp and cannot build in this standalone project.
         The explicit <Compile Include> list is the source of truth. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile the M08 combat source files directly into this test
         assembly (the same files the Godot project compiles, so test and
         engine always run the same code). -->
    <Compile Include="../src/combat/CombatVec3.cs" />
    <Compile Include="../src/combat/EnemyAI.cs" />
    <Compile Include="../src/combat/CombatSystem.cs" />
    <Compile Include="../src/combat/PlayerController.cs" />
    <!-- M02 DNA sources the combat OnKill wire needs (C10 -> M02 extract). -->
    <Compile Include="../src/dna/DnaLanguage.cs" />
    <Compile Include="../src/dna/DnaMessage.cs" />
    <Compile Include="../src/dna/LanguageSignature.cs" />
    <Compile Include="../src/dna/EcosystemAdaptation.cs" />
    <!-- The test files themselves (EnableDefaultCompileItems=false above, so
         they must be listed explicitly). The harness self-test is compiled
         conditionally so the gate script can drop it out with
         `/p:IncludeHarness=false` for the "real suite green" run (two-sided
         calibration, same pattern as ci/dna_npc_test.sh). -->
    <Compile Include="Combat3DTests.cs" />
    <Compile Include="CombatHarnessSelfTest.cs" Condition=" '$(IncludeHarness)' != 'false' " />
  </ItemGroup>

</Project>
