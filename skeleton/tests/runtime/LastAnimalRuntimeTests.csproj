<Project Sdk="Microsoft.NET.Sdk">
  <!-- Last Animal — T3b runtime-ownership test project (MC 1256.9, artemis, 2026-09-21).
       STANDALONE headless xunit project for the ONE-authoritative-runtime-path
       refactor (design 1256.2). References the pure src/ files directly — the
       same files the Godot project compiles — so test and engine always run
       the same code. Follows the two-sided-harness convention: the harness
       self-test is compiled conditionally and the gate runs
       `dotnet test -p:IncludeHarness=false` for the green run. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>LastAnimalRuntimeTests</AssemblyName>
    <RootNamespace>LastAnimal.Tests</RootNamespace>
    <!-- Compile ONLY the explicitly listed files below (the fleet convention:
         a default glob would pull Godot-bound test files into a headless
         build and break with CS0246). -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pure sources the ownership contracts live on. -->
    <Compile Include="../../src/combat/CombatVec3.cs" />
    <Compile Include="../../src/combat/EnemyAI.cs" />
    <Compile Include="../../src/combat/CombatSystem.cs" />
    <Compile Include="../../src/combat/PlayerController.cs" />
    <Compile Include="../../src/dna/DnaLanguage.cs" />
    <Compile Include="../../src/dna/DnaMessage.cs" />
    <Compile Include="../../src/dna/LanguageSignature.cs" />
    <Compile Include="../../src/dna/EcosystemAdaptation.cs" />
    <Compile Include="../../src/npc/SalarySystem.cs" />
    <Compile Include="../../src/npc/BetrayalSystem.cs" />
    <Compile Include="../../src/npc/CompanionComponent.cs" />
    <Compile Include="../../src/npc/EmotionalDepth.cs" />
    <Compile Include="../../src/companion/CompanionStateMachine.cs" />
    <Compile Include="../../src/companion/CompanionNeeds.cs" />
    <Compile Include="../../src/companion/CompanionAnimationHook.cs" />
    <!-- The test files themselves. -->
    <Compile Include="RuntimeOwnershipTests.cs" />
    <Compile Include="RuntimeHarnessSelfTest.cs" Condition=" '$(IncludeHarness)' != 'false' " />
  </ItemGroup>

</Project>
