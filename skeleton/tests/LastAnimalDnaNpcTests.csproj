<Project Sdk="Microsoft.NET.Sdk">
  <!-- Last Animal — M02+M03 pure-logic test project (MC 890.2, dobbie, 2026-09-03).
       This is a STANDALONE test project: it references the M02/M03 source files
       directly (via Compile Include) so `dotnet test` runs the pure-logic
       suites headless without pulling in the Godot SDK. The Godot project
       (LastAnimalPreflight.csproj) compiles the same source files for the
       engine; this project is the test-only entry point. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Assembly name must not collide with the Godot project's assembly. -->
    <AssemblyName>LastAnimalDnaNpcTests</AssemblyName>
    <RootNamespace>LastAnimal.Tests</RootNamespace>
    <!-- THE CROSS-MODULE GLOB FIX (MC 890.17, artemis, 2026-09-06).
         This project is a STANDALONE pure-logic suite. It must NOT glob the
         whole tests/ dir for .cs — that pulled in every other milestone's
         tests (Combat3DTests.cs, EcosystemSpawnerTests.cs, the companion/,
         save/, ui/ sub-folder render/Godot-bound suites) and broke the M02+M03
         DNA gate with CS0234/CS0246 (regression 2026-09-06). Compile ONLY the
         explicitly listed test files below; the list is the source of truth. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile the M02/M03 source files directly into this test assembly.
         These are the same files the Godot project compiles; keeping them
         in one place (src/) means the test project and the Godot project
         always test the same code. -->
    <Compile Include="../src/dna/DnaLanguage.cs" />
    <Compile Include="../src/dna/DnaMessage.cs" />
    <Compile Include="../src/dna/LanguageSignature.cs" />
    <Compile Include="../src/dna/EcosystemAdaptation.cs" />
    <Compile Include="../src/npc/SalarySystem.cs" />
    <Compile Include="../src/npc/BetrayalSystem.cs" />
    <Compile Include="../src/npc/CompanionComponent.cs" />
    <Compile Include="../src/npc/EmotionalDepth.cs" />
    <Compile Include="../src/companion/CompanionStateMachine.cs" />
    <Compile Include="../src/companion/CompanionNeeds.cs" />
    <Compile Include="../src/companion/CompanionAnimationHook.cs" />
    <Compile Include="../src/empathy/EmpathyBook.cs" />
    <!-- This suite's OWN test files (EnableDefaultCompileItems=false above, so
         they must be listed explicitly). Exactly the M02+M03 pure-logic suite:
         DnaLanguageTests + NpcEmotionTests + the HarnessSelfTest calibration.
         The harness self-test is compiled conditionally so the gate script can
         drop it out with /p:IncludeHarness=false for the "real suite green"
         run (two-sided calibration, same pattern as ci/combat_test.sh and
         ci/ecosystem_test.sh). -->
    <Compile Include="DnaLanguageTests.cs" />
    <Compile Include="NpcEmotionTests.cs" />
    <Compile Include="HarnessSelfTest.cs" Condition=" '$(IncludeHarness)' != 'false' " />
  </ItemGroup>

</Project>
