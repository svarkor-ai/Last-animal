<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet sources for the Last Animal M00 preflight (MC 839.2, gunilla, 2026-08-31).
  Lives in skeleton/ because that is the project root (res://) and therefore the
  directory `dotnet build` walks up from when it looks for a NuGet.Config.

  The GodotSharp SDK + API packages ship INSIDE the pinned mono editor download
  (engine/Godot_v4.7.2-stable_mono_linux_x86_64/GodotSharp/Tools/nupkgs/). Pointing
  NuGet at that folder FIRST means Godot.NET.Sdk / GodotSharp resolve locally and a
  build can never silently pull a GodotSharp that does not match the pinned engine
  (see engine/PIN.txt). Verified in MC 839.2: restore + compile succeed from this
  feed alone (PREFLIGHT.md §4).

  nuget.org stays listed only for unrelated transitive packages; our GodotSharp
  versions are exact, so nothing Godot-related can float.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="godot-pinned-local" value="../engine/Godot_v4.7.2-stable_mono_linux_x86_64/GodotSharp/Tools/nupkgs" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
