; Engine configuration — Last Animal M09 C12 retarget bake (MC 890.5, dobbie, 2026-09-03).
; Minimal standalone C# project to host bake_check.cs (a SceneTree) and run it headless.
; Uses the pinned engine: gunilla/engine/Godot_v4.7.2-stable_mono_linux_x86_64.
config_version=5

[application]
config/name="Last Animal M09 C12 retarget bake"
run/main_scene=""
config/features=PackedStringArray("4.7", "Forward Plus")

[dotnet]
project/assembly_name="LastAnimalM09Bake"

[rendering]
renderer/rendering_method="forward_plus"
